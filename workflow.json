    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\nconst leadId = 'lead_' + Date.now();\nconst receivedAt = new Date().toISOString();\nconst priority = \n  body.projectType === 'seller' && body.budget > 400000 ? 'high' :\n  body.projectType === 'seller' && body.budget <= 400000 ? 'medium' :\n  body.projectType === 'buyer' && body.budget > 400000 ? 'medium' :\n  'normal';\nconst summary = `${body.firstName} ${body.lastName} est un lead ${body.projectType} à ${body.city} avec un budget de ${body.budget} €.`;\n\nreturn [{\n  json: {\n    ...body,\n    leadId,\n    receivedAt,\n    priority,\n    summary\n  }\n}];"
      },
