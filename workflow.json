      "name": "Validation des données"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\nconst leadId = 'lead_' + Date.now();\nconst receivedAt = new Date().toISOString();\nconst priority = body.projectType === 'seller' || body.budget > 400000 ? 'high' : 'normal';\nconst summary = `${body.firstName} ${body.lastName} est un lead ${body.projectType} à ${body.city} avec un budget de ${body.budget} €.`;\n\nreturn [{\n  json: {\n    ...body,\n    leadId,\n    receivedAt,\n    priority,\n    summary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
